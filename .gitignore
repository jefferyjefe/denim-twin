# EXP_0021: silhouette masks derived from all-rights-reserved control/unpaired photos.
# Derived numbers go in the repo; a traced outline of a copyrighted photograph does not.
reports/repeatability/masks/

# Derived imagery from the found-pair photographs (all-rights-reserved tutorial and retailer images): renders,
# masks, panels and diffs are derivative works of photographs this project is not licensed to redistribute, and the
# policy in data/external/README.md is that only derived NUMBERS enter the repository. .gitignore covered
# experiments/pairs/ but not the other batch directories, so every A/B arm committed its renders (EXP_0022).
experiments/**/*.png
experiments/**/*.jpg
experiments/**/*.jpeg

# EXP_0042's two A/B arms: full batch runs kept locally so the comparison can be re-derived without
# re-segmenting. Regenerate with PAIRS_OUT=<dir> [PAIRS_REFIT_LM=1] tools/run_pairs_batch.py. Only the
# comparison's numbers enter the repository, for the reason above.
experiments/pairs_lmprov_control/
experiments/pairs_lmprov_refit/

# The pilot capture log in its LOCAL form. It carries full EXIF -- which on a phone includes GPS --
# and it is the working copy the session appends to. Only the sanitised projection may enter the
# repository: `tools/pilot.py finalize` writes manifest.sanitised.json with location tags dropped and
# every path made repo-relative, and refuses to write at all if an absolute path survives.
# The witness: one line per append, {seed, chain, count} only -- no photograph, no path, no EXIF.
# Untracked by default so an ordinary capture session does not churn the repository. COMMITTING it
# would make git history a third independent witness, which is strictly stronger; that is a
# deliberate choice to make, not a default to impose.
data/garments/.pilot_witness.jsonl

data/garments/**/pilot/manifest.jsonl
# The witness: one line per append, {seed, chain, count} only -- no photograph, no path, no EXIF.
# Untracked by default so an ordinary capture session does not churn the repository. COMMITTING it
# would make git history a third independent witness, which is strictly stronger; that is a
# deliberate choice to make, not a default to impose.
data/garments/.pilot_witness.jsonl

data/garments/**/pilot/manifest.jsonl.torn
data/garments/**/pilot/.incoming/

# Isolated worktrees created for adversarial agents. Their findings live in the selftest scenarios
# and docs/PILOT_ADVERSARIAL_ROUNDS.md; the trees themselves are scratch.
.claude/
